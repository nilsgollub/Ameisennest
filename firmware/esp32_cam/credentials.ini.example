; ============================================================
; FORMICA-OS — Kameranode Zugangsdaten (Template)
;
; Kopieren und umbenennen:
;   cp credentials.ini.example credentials.ini
;
; credentials.ini ist in .gitignore — wird NICHT committet.
; ============================================================

[env:dfr1154_cam]
build_flags =
    ${base.build_flags}
    -DWIFI_SSID=\"DEIN_WLAN\"
    -DWIFI_PASS=\"DEIN_PASSWORT\"
    -DMQTT_BROKER=\"192.168.1.XXX\"
